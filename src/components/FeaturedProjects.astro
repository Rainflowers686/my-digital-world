---
import SectionHeading from './SectionHeading.astro';

const projects = [
  {
    title: '个人网站',
    description: '基于 Astro 6 与 Tailwind CSS 构建的个人数字空间，注重排版与阅读体验。',
    tags: ['Astro', 'TypeScript', 'Tailwind'],
  },
  {
    title: 'AI 学习助手',
    description: '接入大语言模型 API 的智能学习工具，支持对话问答与知识检索。',
    tags: ['Python', 'LangChain', 'FastAPI'],
  },
  {
    title: '组件库设计',
    description: '面向现代 Web 应用的 UI 组件系统，注重无障碍访问与主题定制。',
    tags: ['React', 'Storybook', 'Radix UI'],
  },
];
---

<section id="projects" class="section-shell">
  <SectionHeading
    mono="Selected Work"
    title="精选项目"
    subtitle="近期完成的一些作品，体现技术深度与设计思考。"
  />

  <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
    {projects.map((project) => (
      <div class="soft-card p-6 flex flex-col">
        <h3 class="text-base font-medium text-[var(--text)] mb-2 font-serif">
          {project.title}
        </h3>
        <p class="text-sm text-[var(--muted)] leading-relaxed mb-5 flex-1">
          {project.description}
        </p>
        <div class="flex flex-wrap gap-1.5">
          {project.tags.map((tag) => (
            <span class="tag-pill">{tag}</span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
