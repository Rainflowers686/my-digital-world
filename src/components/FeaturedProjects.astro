---
import type { CollectionEntry } from 'astro:content';
import SectionHeading from './SectionHeading.astro';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;

const statusLabel: Record<string, string> = {
  completed: '已完成',
  'in-progress': '进行中',
  planned: '计划中',
};
---

<section id="projects" class="section-shell">
  <SectionHeading
    mono="Selected Work"
    title="精选项目"
    subtitle="近期完成的一些作品，体现技术深度与设计思考。"
  />

  <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
    {projects.map((project) => (
      <a
        href={`/projects/${project.id}`}
        class="soft-card p-6 flex flex-col group"
      >
        <h3 class="text-base font-medium text-[var(--text)] mb-2 font-serif group-hover:text-[var(--accent)] transition-colors duration-200">
          {project.data.title}
        </h3>
        <p class="text-sm text-[var(--muted)] leading-relaxed mb-5 flex-1">
          {project.data.description}
        </p>
        <div class="flex flex-wrap gap-1.5">
          {project.data.tags.map((tag) => (
            <span class="tag-pill">{tag}</span>
          ))}
        </div>
      </a>
    ))}
  </div>
</section>
