---
import SectionHeading from './SectionHeading.astro';

const articles = [
  {
    title: 'Astro 6 初探：构建现代内容站点的新范式',
    description: '深入了解岛屿架构、内容集合与 View Transitions API。',
    date: '2026-04-28',
  },
  {
    title: 'Tailwind CSS v4 实践指南',
    description: 'CSS 优先配置与自定义主题的完整迁移方案。',
    date: '2026-04-15',
  },
  {
    title: '玻璃拟态设计：从灵感到实现',
    description: '用 CSS backdrop-filter 探索液态玻璃视觉风格。',
    date: '2026-03-22',
  },
];
---

<section id="articles" class="section-shell border-t border-[var(--glass-border)]">
  <SectionHeading
    label="写作"
    title="Articles"
    subtitle="记录学习过程中的思考与发现。"
  />

  <div class="flex flex-col gap-3">
    {articles.map((article) => (
      <a
        href="#"
        class="group flex items-center justify-between gap-6 p-5 rounded-xl border border-transparent hover:bg-white/[0.03] hover:border-[var(--glass-border)] transition-all duration-300"
      >
        <div class="min-w-0">
          <h3 class="text-[15px] font-medium text-white mb-1 group-hover:text-[var(--primary-soft)] transition-colors duration-200">
            {article.title}
          </h3>
          <p class="text-[13px] text-[var(--muted)] leading-relaxed">
            {article.description}
          </p>
        </div>
        <span class="text-[13px] text-[var(--muted)] flex-shrink-0">{article.date}</span>
      </a>
    ))}
  </div>

  <div class="mt-8">
    <a href="#" class="text-[13px] text-[var(--muted)] hover:text-white transition-colors duration-200 inline-flex items-center gap-1.5">
      全部文章
      <span class="text-xs">→</span>
    </a>
  </div>
</section>
