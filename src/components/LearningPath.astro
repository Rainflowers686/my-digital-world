---
import SectionHeading from './SectionHeading.astro';

const steps = [
  {
    title: '前端基础',
    description: 'HTML、CSS、JavaScript 核心能力，语义化与响应式设计',
    done: true,
  },
  {
    title: 'React 生态',
    description: '组件化思维、状态管理、Next.js 服务端渲染',
    done: false,
  },
  {
    title: '全栈开发',
    description: 'Node.js、数据库设计、API 开发与系统架构',
    done: false,
  },
  {
    title: '工程化实践',
    description: 'CI/CD、Docker、性能优化与可观测性',
    done: false,
  },
];
---

<section id="learning" class="section-shell border-t border-[var(--glass-border)]">
  <SectionHeading
    label="成长路径"
    title="Learning"
    subtitle="从基础到工程化的系统学习路线。"
  />

  <div class="grid grid-cols-1 md:grid-cols-4 gap-5">
    {steps.map((step, i) => (
      <div class="relative">
        {/* 连接线 */}
        {i < steps.length - 1 && (
          <div class="hidden md:block absolute top-5 left-[calc(100%+0.25rem)] w-[calc(1.25rem-2px)] h-px bg-[var(--glass-border)]" />
        )}

        <div class="flex items-center gap-3 mb-3">
          <div
            class:list={[
              'flex items-center justify-center w-5 h-5 rounded-full text-[10px] font-bold flex-shrink-0',
              step.done
                ? 'bg-[var(--primary)] text-white'
                : 'bg-white/5 text-[var(--muted)] border border-[var(--glass-border)]',
            ]}
          >
            {step.done ? '✓' : i + 1}
          </div>
          <h3 class="text-sm font-semibold text-white">{step.title}</h3>
        </div>
        <p class="text-[13px] text-[var(--muted)] leading-relaxed pl-8">{step.description}</p>
      </div>
    ))}
  </div>
</section>
