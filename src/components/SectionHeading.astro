---
interface Props {
  mono?: string;
  title: string;
  subtitle?: string;
}

const { mono, title, subtitle } = Astro.props;
---

<div class="mb-8 md:mb-12 text-center">
  {mono && <p class="mono-label mb-2 md:mb-3">{mono}</p>}
  <h2 class="text-2xl md:text-3xl font-normal text-[var(--text)] mb-2 md:mb-3 tracking-[-0.015em]">
    {title}
  </h2>
  {subtitle && (
    <p class="text-[15px] text-[var(--muted)] max-w-lg mx-auto leading-relaxed">
      {subtitle}
    </p>
  )}
</div>
