---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';

const experiments = [
  {
    title: '算法可视化',
    description: '配合数据结构课程的算法动画演示工具——排序、搜索、图论逐步可视化。',
    status: '计划中',
  },
  {
    title: '个人知识库',
    description: '基于 Obsidian + MDX 的笔记发布系统，将本地笔记转化为网站内容。',
    status: '计划中',
  },
  {
    title: 'AI 学习助手',
    description: '接入 Claude API 的轻量对话组件，探索 AI 辅助编程与学习的可能。',
    status: '计划中',
  },
  {
    title: 'UI 组件实验',
    description: 'CSS 微交互、响应式组件、页面过渡动画的实验与收集。',
    status: '计划中',
  },
  {
    title: 'Bilibili 教学视频',
    description: '计算机学习过程的视频记录与知识分享入口。',
    status: '计划中',
  },
];
---

<Layout title="实验室" description="实验性项目与交互组件试验场。">
  <main class="section-shell pt-20">
    <SectionHeading
      mono="Experiments"
      title="实验室"
      subtitle="一些实验性的小项目、交互组件和视觉探索。"
    />

    <div class="max-w-2xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {experiments.map((exp) => (
          <div class="soft-card p-5">
            <div class="flex items-center gap-2 mb-2">
              <h2 class="text-sm font-medium text-[var(--text)] font-serif">
                {exp.title}
              </h2>
              <span class="tag-pill !text-[10px]">{exp.status}</span>
            </div>
            <p class="text-[13px] text-[var(--muted)] leading-relaxed">
              {exp.description}
            </p>
          </div>
        ))}
      </div>

      <p class="text-center text-[13px] text-[var(--muted)] mt-12">
        更多实验项目即将上线。如果你有有趣的想法，欢迎交流。
      </p>
    </div>
  </main>
</Layout>
