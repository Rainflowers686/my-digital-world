---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';

const phases = [
  {
    title: '编程基础',
    items: ['C 语言：指针、内存管理、结构体', 'Python：面向对象、常用库、脚本编写', 'Git 版本控制', '命令行基础'],
    done: true,
  },
  {
    title: '前端入门',
    items: ['HTML 语义化', 'CSS Flexbox / Grid 布局', '响应式设计', 'JavaScript 基础与 DOM 操作'],
    done: true,
  },
  {
    title: 'Web 开发框架',
    items: ['React 组件化思维', 'Astro 静态站点生成', 'Tailwind CSS 主题系统', '个人网站完整项目实践'],
    done: true,
  },
  {
    title: '数据结构与算法',
    items: ['数组与链表', '栈与队列', '树与图基础', '排序与搜索算法'],
    done: false,
  },
  {
    title: '计算机系统基础',
    items: ['二进制与编码', 'CPU 与内存基础', '操作系统入门', '计算机网络基础'],
    done: false,
  },
  {
    title: '数据库与后端',
    items: ['SQL 基础', 'Node.js / Express 入门', 'REST API 设计', '简单的后端服务搭建'],
    done: false,
  },
  {
    title: '工程化与部署',
    items: ['Git 工作流与协作', 'Cloudflare Pages 部署', 'CI/CD 自动化', '基础性能优化'],
    done: false,
  },
];
---

<Layout title="学习路线" description="系统性计算机科学学习路径。">
  <main class="section-shell pt-20">
    <SectionHeading
      mono="Growth Path"
      title="学习路线"
      subtitle="从编程基础到工程化实践，一条持续成长的学习路径。"
    />

    <div class="max-w-2xl mx-auto">
      {phases.map((phase, i) => (
        <div class="relative flex gap-5 pb-8 last:pb-0">
          {/* Timeline */}
          <div class="flex flex-col items-center flex-shrink-0">
            <div
              class:list={[
                'w-5 h-5 rounded-full border-2 flex items-center justify-center text-[10px] font-medium',
                phase.done
                  ? 'bg-[var(--accent)] border-[var(--accent)] text-white'
                  : 'bg-transparent border-[var(--border)] text-[var(--muted)]',
              ]}
            >
              {phase.done ? '✓' : i + 1}
            </div>
            {i < phases.length - 1 && (
              <div class="w-0.5 flex-1 bg-[var(--border)] mt-1" />
            )}
          </div>

          {/* Content */}
          <div class="pb-2">
            <h2 class="text-base font-medium text-[var(--text)] font-serif mb-2">
              {phase.title}
            </h2>
            <ul class="space-y-1">
              {phase.items.map((item) => (
                <li class="text-[13px] text-[var(--muted)] flex items-center gap-2">
                  <span class="w-1 h-1 rounded-full bg-[var(--border)] flex-shrink-0" />
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </main>
</Layout>
